// The reference workload, written in Vortex.
//
// The same arithmetic, in the same order, as bench/c/sieve.c and
// bench/rust/src/main.rs. This prints `checksum 1179908154 3314.003906`, the
// same value both baselines print, so bench/run.sh will give this row a time.
//
// Two details matter for that, and both are recorded rather than stumbled on.
//
// The C baseline accumulates into a `uint32_t`, so the sieve sum wraps at 2^32.
// Vortex `Int` is 64 bit, so a plain sum gives 142913828922. `wrap32` masks to
// the width the baselines use. Masking rather than widening the Vortex type is
// deliberate: a program that wants the true sum should not have to imitate a C
// overflow.
//
// The matrix part needs `Int` to `Float` and back, which `SPEC.md` section 6.1
// rule 4 forbids implicitly and requires to be written as `as`.
//
// This uses the two forms stage 3 added: a list of a computed length,
// `[0; limit + 1]`, and index assignment, `composite[j] = 1`.

// Keeps a value inside 32 bits, the width the baselines accumulate in.
fn wrap32(n: Int) -> Int {
    return n % 4294967296;
}

fn sieve_sum(limit: Int) -> Int {
    if limit < 2 {
        return 0;
    }

    // One flag per number up to the limit, which is why a list of a computed
    // length is needed here at all.
    var composite = [0; limit + 1];

    var total = 0;
    var i = 2;
    while i <= limit {
        if composite[i] == 1 {
            i = i + 1;
            continue;
        }
        total = wrap32(total + i);

        // The inner loop runs only while i squared is within the limit, so the
        // arithmetic matches the baselines exactly.
        var j = i * i;
        while j <= limit {
            composite[j] = 1;
            j = j + i;
        }
        i = i + 1;
    }

    total
}

// The same matrix workload as the baselines: a 256 by 256 pair of arrays, eight
// passes of add then scale, and the trace summed.
fn matrix_work() -> Float {
    let n = 256;
    let size = n * n;

    var a = [0.0; size];
    var b = [0.0; size];
    var c = [0.0; size];

    var i = 0;
    while i < n {
        var j = 0;
        while j < n {
            a[i * n + j] = ((i + j) % 17) as Float;
            b[i * n + j] = ((i * 3 + j * 5) % 23) as Float;
            j = j + 1;
        }
        i = i + 1;
    }

    // Eight passes, each one two full sweeps over the arrays, exactly as the
    // baselines do it.
    var k = 0;
    while k < 8 {
        // c = a + b
        var p = 0;
        while p < n {
            var q = 0;
            while q < n {
                c[p * n + q] = a[p * n + q] + b[p * n + q];
                q = q + 1;
            }
            p = p + 1;
        }
        // a = c * 0.5 + 1.0
        var r = 0;
        while r < n {
            var s = 0;
            while s < n {
                a[r * n + s] = c[r * n + s] * 0.5 + 1.0;
                s = s + 1;
            }
            r = r + 1;
        }
        k = k + 1;
    }

    var total = 0.0;
    var m = 0;
    while m < n {
        total = total + a[m * n + m];
        m = m + 1;
    }
    total
}

fn main() -> Int {
    let s = sieve_sum(2000000);
    let m = matrix_work();
    println("checksum " + int_to_string(s) + " " + float_to_string(m));
    return 0;
}
