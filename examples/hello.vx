// A first Vortex program. It exercises functions, parameters, `var`, `let`,
// arithmetic, comparison, `while` and `return`.
//
// The parameter `b` is written `var` so it can be reassigned. See SPEC.md
// section 8: a parameter is immutable unless it is declared `var`.

fn gcd(var a: Int, var b: Int) -> Int {
    while b != 0 {
        let t = b;
        b = a % b;
        a = t;
    }
    return a;
}

fn fib(n: Int) -> Int {
    // Recursion needs no `mut`. See SPEC.md section 6.1 rule 9.
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main() {
    println(int_to_string(gcd(1071, 462)));
    println(int_to_string(fib(20)));
    return 0;
}